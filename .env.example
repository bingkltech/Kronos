# ==============================================================================
# Kronos Quantitative Trading Terminal — Environment Template
# ==============================================================================
# Copy this file to .env and insert your real API credentials:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Google Gemini Meta-Strategy Arbiter (AI Strategic Copilot)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 2. Binance USD(S)-M Futures Trading API Credentials
# ------------------------------------------------------------------------------
# Required for Real Live Trading execution and real-time account telemetry.
#
# SECURITY INVARIANTS:
#   1. Enable "Reading"
#   2. Enable "Futures Trading"
#   3. NEVER Enable "Withdrawals" (Keep withdrawals strictly disabled)
#   4. (Recommended) Restrict access to your trusted static IP address.
#
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# Network Mode:
#   false = Real Capital Live Trading (https://fapi.binance.com) [Default]
#   true  = Binance Futures Testnet (https://testnet.binancefuture.com)
BINANCE_TESTNET=false

# Optional Fallback Aliases (Supported interchangeably by the execution gateway):
# BINANCE_FUTURES_API_KEY=""
# BINANCE_FUTURES_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 3. Kronos Terminal Web UI Configuration
# ------------------------------------------------------------------------------
KRONOS_HOST=0.0.0.0
KRONOS_PORT=7070
